# Copy to .env.local and fill in. Restart `npx expo start` after changing.

# --- Production backend (Supabase) ---
# When both are set, the app uses sign in, server credits and server-side AI.
# Find them in Supabase → Project Settings → API. The publishable (anon) key is safe to ship.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Prototype only (no backend) ---
# Calls OpenAI straight from the phone. NEVER use in a store build.
EXPO_PUBLIC_OPENAI_API_KEY=
